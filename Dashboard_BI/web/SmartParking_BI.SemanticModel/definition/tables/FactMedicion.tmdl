table FactMedicion
	lineageTag: 31df0bbe-7137-4110-bfc5-0b5ac0dcd74c

	measure Ocupaciones = SUM(FactMedicion[ocupaciones_iniciadas])
		formatString: #,0
		displayFolder: Histórico
		lineageTag: ee94bea9-1738-44ca-88bc-b3a611ab2555

	measure '% Ocupación' = DIVIDE(SUM(FactMedicion[lecturas_ocupado]), CALCULATE(SUM(FactMedicion[lecturas_validas]), DimSensor[modelo] = "HC-SR04"))
		formatString: 0.0%
		displayFolder: Histórico
		lineageTag: c016154f-39a5-49f6-b94b-769b0d667dfe

	measure 'Entradas de carros' = SUM(FactMedicion[entradas])
		formatString: #,0
		displayFolder: Histórico
		lineageTag: 4659b830-ff8f-4147-8a8b-1968dd123077

	measure 'Rechazos por lleno' = SUM(FactMedicion[rechazos_por_lleno])
		formatString: #,0
		displayFolder: Histórico
		lineageTag: 97393203-3bc8-4eeb-a2e7-3a6ea2693a3a

	measure '% Rechazo' = DIVIDE(SUM(FactMedicion[rechazos_por_lleno]), SUM(FactMedicion[entradas]) + SUM(FactMedicion[rechazos_por_lleno]))
		formatString: 0.0%
		displayFolder: Histórico
		lineageTag: cfa2dbba-6e15-42cd-9183-91a8247b9655

	measure Lecturas = SUM(FactMedicion[total_lecturas])
		formatString: #,0
		displayFolder: Calidad
		lineageTag: 02abb43b-e21b-4552-aa0a-354a84dbe3df

	measure 'Lecturas con error' = SUM(FactMedicion[lecturas_error])
		formatString: #,0
		displayFolder: Calidad
		lineageTag: eb51c824-2bea-4b6a-b789-c47600a44135

	measure '% Error de sensor' = DIVIDE(SUM(FactMedicion[lecturas_error]), SUM(FactMedicion[total_lecturas]))
		formatString: 0.0%
		displayFolder: Calidad
		lineageTag: 3a53b4a8-6ab4-4997-a105-f24bc63ddd3f

	measure 'Última carga al DW' = MAX(FactMedicion[fecha_carga])
		formatString: dd/MM/yyyy HH:mm:ss
		displayFolder: Calidad
		lineageTag: aa5ce762-43ba-40b8-ab0f-7697fabafff3

	measure 'Texto carga DW' = "Datos tomados del DW · última carga " & FORMAT([Última carga al DW], "dd/MM/yyyy HH:mm:ss")
		displayFolder: Calidad
		lineageTag: 65e9de5d-0f58-467b-a11b-a949432ef8c5

	measure 'SVG lead red' = VAR num = FORMAT([% Ocupación] * 100, "0.0") & " &#37;" VAR l1 = FORMAT([Ocupaciones], "#,0") & " ocupaciones y " & FORMAT([Entradas de carros], "#,0") VAR l3 = "No entr&#243; el " & FORMAT([% Rechazo] * 100, "0.0") & " &#37; de los carros." RETURN "data:image/svg+xml;utf8," & "<svg xmlns='http://www.w3.org/2000/svg' width='296' height='190' viewBox='0 0 296 190'>" & "<text x='0' y='62' font-family='Bahnschrift SemiBold,Bahnschrift,Segoe UI,sans-serif' font-size='64' fill='%23f0efec'>" & num & "</text>" & "<text x='0' y='90' font-family='Segoe UI,sans-serif' font-size='14' fill='%23c3c2b7'>ocupaci&#243;n media de los espacios</text>" & "<text x='0' y='132' font-family='Segoe UI,sans-serif' font-size='13' fill='%23c3c2b7'>" & l1 & "</text>" & "<text x='0' y='151' font-family='Segoe UI,sans-serif' font-size='13' fill='%23c3c2b7'>entradas en el periodo elegido.</text>" & "<text x='0' y='176' font-family='Segoe UI,sans-serif' font-size='13' fill='%23c3c2b7'>" & l3 & "</text></svg>"
		displayFolder: Dibujos
		lineageTag: f1912a70-6f23-44fb-9ae6-fa93896ac6b2
		dataCategory: ImageUrl

	measure 'SVG lead congestion' = VAR num = FORMAT([Rechazos por lleno], "#,0") VAR l1 = "Son el " & FORMAT([% Rechazo] * 100, "0.0") & " &#37; de los que llegaron." VAR l2 = FORMAT([Lecturas con error], "#,0") & " lecturas de sensor salieron" VAR l3 = "con error, el " & FORMAT([% Error de sensor] * 100, "0.0") & " &#37; del total." RETURN "data:image/svg+xml;utf8," & "<svg xmlns='http://www.w3.org/2000/svg' width='296' height='190' viewBox='0 0 296 190'>" & "<text x='0' y='62' font-family='Bahnschrift SemiBold,Bahnschrift,Segoe UI,sans-serif' font-size='64' fill='%23f0efec'>" & num & "</text>" & "<text x='0' y='90' font-family='Segoe UI,sans-serif' font-size='14' fill='%23c3c2b7'>carros rechazados por estar lleno</text>" & "<text x='0' y='132' font-family='Segoe UI,sans-serif' font-size='13' fill='%23c3c2b7'>" & l1 & "</text>" & "<text x='0' y='158' font-family='Segoe UI,sans-serif' font-size='13' fill='%23c3c2b7'>" & l2 & "</text>" & "<text x='0' y='176' font-family='Segoe UI,sans-serif' font-size='13' fill='%23c3c2b7'>" & l3 & "</text></svg>"
		displayFolder: Dibujos
		lineageTag: 4c163d46-1a58-4707-8b1a-e587b60571e1
		dataCategory: ImageUrl

