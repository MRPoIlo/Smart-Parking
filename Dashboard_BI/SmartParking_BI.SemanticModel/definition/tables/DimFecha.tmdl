table DimFecha

	column sk_fecha
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: sk_fecha

	column fecha
		dataType: dateTime
		formatString: dd/MM/yyyy
		summarizeBy: none
		sourceColumn: fecha

	column anio
		dataType: int64
		summarizeBy: none
		sourceColumn: anio

	column trimestre
		dataType: int64
		summarizeBy: none
		sourceColumn: trimestre

	column mes
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: mes

	column nombre_mes
		dataType: string
		summarizeBy: none
		sortByColumn: mes
		sourceColumn: nombre_mes

	column anio_mes
		dataType: string
		summarizeBy: none
		sourceColumn: anio_mes

	column semana_anio
		dataType: int64
		summarizeBy: none
		sourceColumn: semana_anio

	column dia_mes
		dataType: int64
		summarizeBy: none
		sourceColumn: dia_mes

	column dia_semana
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: dia_semana

	column nombre_dia
		dataType: string
		summarizeBy: none
		sortByColumn: dia_semana
		sourceColumn: nombre_dia

	column es_fin_semana
		dataType: boolean
		summarizeBy: none
		sourceColumn: es_fin_semana

	column es_festivo
		dataType: boolean
		summarizeBy: none
		sourceColumn: es_festivo

	column nombre_festivo
		dataType: string
		summarizeBy: none
		sourceColumn: nombre_festivo

	column tipo_dia
		dataType: string
		summarizeBy: none
		sourceColumn: tipo_dia

	partition DimFecha = m
		mode: directQuery
		source =
				let
				    Origen = Sql.Database(Servidor, BaseDatos),
				    Tabla = Origen{[Schema = "dbo", Item = "DimFecha"]}[Data]
				in
				    Tabla

	annotation PBI_ResultType = Table
