	partition DimSensor = m
		mode: directQuery
		source =
				let
				    Origen = Sql.Database(Servidor, BaseDatos),
				    Tabla = Origen{[Schema = "dbo", Item = "DimSensor"]}[Data]
				in
				    Tabla

	annotation PBI_ResultType = Table
