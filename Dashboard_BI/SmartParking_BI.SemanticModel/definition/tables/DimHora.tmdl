table DimHora

	column sk_hora
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: sk_hora

	column hora_texto
		dataType: string
		summarizeBy: none
		sortByColumn: sk_hora
		sourceColumn: hora_texto

	column rango_hora
		dataType: string
		summarizeBy: none
		sortByColumn: sk_hora
		sourceColumn: rango_hora

	column franja
		dataType: string
		summarizeBy: none
		sourceColumn: franja

	column es_hora_pico
		dataType: boolean
		summarizeBy: none
		sourceColumn: es_hora_pico

	column jornada
		dataType: string
		summarizeBy: none
		sourceColumn: jornada

	partition DimHora = m
		mode: directQuery
		source =
				let
				    Origen = Sql.Database(Servidor, BaseDatos),
				    Tabla = Origen{[Schema = "dbo", Item = "DimHora"]}[Data]
				in
				    Tabla

	annotation PBI_ResultType = Table
