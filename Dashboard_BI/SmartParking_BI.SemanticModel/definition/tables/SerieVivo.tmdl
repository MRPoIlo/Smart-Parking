table SerieVivo

	column hora_inicio
		dataType: dateTime
		formatString: dd/MM/yyyy HH:mm
		summarizeBy: none
		sourceColumn: hora_inicio

	column etiqueta_hora
		dataType: string
		summarizeBy: none
		sortByColumn: hora_inicio
		sourceColumn: etiqueta_hora

	column codigo_parqueadero
		dataType: string
		summarizeBy: none
		sourceColumn: codigo_parqueadero

	column pct_ocupacion
		dataType: decimal
		isHidden
		summarizeBy: none
		sourceColumn: pct_ocupacion

	column lecturas
		dataType: int64
		isHidden
		summarizeBy: sum
		sourceColumn: lecturas

	column errores
		dataType: int64
		isHidden
		summarizeBy: sum
		sourceColumn: errores

	column entradas
		dataType: int64
		isHidden
		summarizeBy: sum
		sourceColumn: entradas

	column rechazos
		dataType: int64
		isHidden
		summarizeBy: sum
		sourceColumn: rechazos

	column ocupaciones
		dataType: int64
		isHidden
		summarizeBy: sum
		sourceColumn: ocupaciones

	measure '% Ocupación horaria' = DIVIDE(AVERAGE(SerieVivo[pct_ocupacion]), 100)
		formatString: 0%
		displayFolder: En vivo

	measure 'Entradas 24 h' = COALESCE(SUM(SerieVivo[entradas]), 0)
		formatString: #,0
		displayFolder: En vivo

	measure 'Rechazos 24 h' = COALESCE(SUM(SerieVivo[rechazos]), 0)
		formatString: #,0
		displayFolder: En vivo

	measure 'Lecturas 24 h' = COALESCE(SUM(SerieVivo[lecturas]), 0)
		formatString: #,0
		displayFolder: En vivo

	partition SerieVivo = m
		mode: directQuery
		source =
				let
				    Origen = Sql.Database(Servidor, BaseDatos),
				    Tabla = Origen{[Schema = "dbo", Item = "vw_SerieVivo"]}[Data]
				in
				    Tabla

	annotation PBI_ResultType = Table
