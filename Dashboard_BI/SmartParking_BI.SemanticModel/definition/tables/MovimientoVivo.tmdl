table MovimientoVivo

	column id_movimiento
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: id_movimiento

	column codigo_parqueadero
		dataType: string
		summarizeBy: none
		sourceColumn: codigo_parqueadero

	column tipo
		dataType: string
		summarizeBy: none
		sourceColumn: tipo

	column fecha_hora
		dataType: dateTime
		formatString: dd/MM/yyyy HH:mm:ss
		summarizeBy: none
		sourceColumn: fecha_hora

	column espacios_libres
		dataType: int64
		summarizeBy: none
		sourceColumn: espacios_libres

	partition MovimientoVivo = m
		mode: directQuery
		source =
				let
				    Origen = Sql.Database(Servidor, BaseDatos),
				    Tabla = Origen{[Schema = "dbo", Item = "MovimientoVivo"]}[Data]
				in
				    Tabla

	annotation PBI_ResultType = Table
